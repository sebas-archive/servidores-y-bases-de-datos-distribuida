# Servidor 1 — Debian GNU/Linux
#
# Imagen base y gestor de paquetes propios de Debian; el código de la
# aplicación es el mismo que usa el Servidor 2 (Fedora).
FROM debian:stable

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-pip \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
# Debian marca el Python del sistema como "externally managed" (PEP 668),
# por eso se instala con --break-system-packages dentro del contenedor.
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

COPY . .

EXPOSE 5000 6000

CMD ["python3", "app.py"]
