# Servidor 2 — Fedora Linux
#
# Imagen base y gestor de paquetes propios de Fedora; el código de la
# aplicación es el mismo que usa el Servidor 1 (Debian).
FROM fedora:latest

RUN dnf install -y python3 python3-pip \
 && dnf clean all

WORKDIR /app

COPY requirements.txt ./
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

COPY . .

EXPOSE 5001 6001

CMD ["python3", "app.py"]
